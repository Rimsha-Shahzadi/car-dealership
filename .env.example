# PostgreSQL (production)
DATABASE_URL="postgresql://user:password@localhost:5432/car_dealership?schema=public"

# For local development you can instead use SQLite:
# 1. In prisma/schema.prisma set provider = "sqlite"
# 2. DATABASE_URL="file:./dev.db"

NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="replace-with-a-random-openssl-rand--base64-32-value"
